{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts", "vite.content.config.ts", "vitest.config.ts", "vitest.eval.config.ts", "scripts/**/*.mjs"]
}
